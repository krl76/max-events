# Локальный фундамент (docker-compose.dev.yml)
DATABASE_URL=postgres://max_events:max_events@localhost:5443/max_events
REDIS_URL=redis://localhost:6391

# Backend
PORT=3100
# Local development. Unset means production, which switches off the demo-only toggles below.
NODE_ENV=development

# MAX platform: токен бота из платформы MAX для партнёров (нужен для валидации initData мини-аппа)
MAX_BOT_TOKEN=replace-with-your-bot-token
# Browser HMAC contour (not VITE_USE_MOCK). Default account is `owner` in tools/max-dev-accounts.json.
# MAX_DEV_ACCOUNT=owner
# Teammate with their own MAX user: either add a named row in that JSON, or:
# MAX_DEV_USER={"id":123456,"first_name":"Name","username":"nick","language_code":"ru"}

# Comma-separated MAX user ids allowed to list/resolve reports and apply sanctions. Empty = nobody (fail-closed).
MODERATOR_MAX_USER_IDS=

# Organizer panel account. The first successful login provisions the organizations row from these values,
# or claims the password-less row the seed created under the same login; afterwards the stored account
# (scrypt hash) is the only source of truth and rotating these vars changes nothing.
# ORGANIZER_LOGIN=replace-with-organizer-login
# ORGANIZER_PASSWORD=replace-with-organizer-password
# Rotating the password of an existing account (the remediation path after a leak) also revokes its live
# sessions. Give the password on stdin so it stays out of the shell history and out of `ps`:
#   read -rs PASS; printf '%s' "$PASS" | ORGANIZER_ROTATE_LOGIN=<login> bun --filter svc-backend org:password
# On a server: the same command under "Useful server commands" in DEPLOY.md.

# Payments: none (fail-closed default) or sandbox for local. Live keys stay in env, never in git.
PAYMENT_PROVIDER=sandbox
# PAYMENT_SECRET=replace-with-your-payment-secret
# PAYMENT_SANDBOX_FAIL_AMOUNT=13
# Platform ticket fee in basis points (1000 = 10%). Frozen per payment at success.
# PAYMENT_COMMISSION_BPS=1000

# Friends: MAX Bridge does not expose a friend list. true makes every app user a friend — demo only,
# it inflates the social counters and lets any user discover every other user. Default false.
# Ignored unless NODE_ENV is development or test, so a real host cannot switch it on by accident.
# FRIENDS_DEMO_ALL_USERS=false

# Staging host only (dev.events.versacegus.cc). true lets POST /api/auth/browser-initdata mint
# signed initData for the owner account. Must stay unset/false on events.versacegus.cc (MAX-only).
# AUTH_ALLOW_BROWSER=false
# AUTH_BROWSER_USER={"id":123456,"first_name":"Name","username":"nick","language_code":"ru"}

# MAX AI catalog parser. Leave MODEL_API_KEY unset to keep the Russian keyword parser (no network).
# With a key, models are tried in this order. A timeout, HTTP error, or unusable JSON moves to the next.
# 401/403 stops the list (one key for every model). After the list is exhausted, the keyword parser still answers.
# MODEL_API_KEY=replace-with-your-model-api-key
# MODEL_API_URL=https://opencode.ai/zen/v1
# MODEL_API_MODELS=liquid/lfm-2.5-2.6b:free,thinkingmachines/inkling-small:free,inclusionai/ling-3.0-flash-fin:free,inclusionai/ling-3.0-flash-vl:free,inclusionai/ling-3.0-flash-sante:free,nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,google/gemma-4-31b-it:free,z-ai/glm-5.2:free,poolside/laguna-s-2.1:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nex-agi/nex-n2.5-pro:free,openrouter/free,nvidia/nemotron-3.5-content-safety:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

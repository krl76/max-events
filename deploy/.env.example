# Copy to /opt/max-events/.env on the server. Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Prod: real partner token for MAX client login. kku: any stable secret to sign demo initData.
# MAX_BOT_TOKEN=

# Staging host only (dev.events.versacegus.cc). Must stay unset on events.versacegus.cc.
# AUTH_ALLOW_BROWSER=false

# The image runs with NODE_ENV=production, which is what keeps the demo friend graph off: MAX exposes
# no friend list, so FRIENDS_DEMO_ALL_USERS would make every app user a friend of every other one.
# The kku demo contour can opt in by setting BOTH lines below; never set them on events.versacegus.cc.
# NODE_ENV=development
# FRIENDS_DEMO_ALL_USERS=true

PAYMENT_PROVIDER=sandbox

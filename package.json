{
  "name": "max-events-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "dev:foundation": "docker compose -f docker-compose.dev.yml up -d",
    "dev:foundation:down": "docker compose -f docker-compose.dev.yml down",
    "dev:backend": "bun --filter svc-backend dev",
    "dev:miniapp": "bun --filter app-miniapp dev",
    "seed": "bun --filter svc-backend seed",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "turbo run test --concurrency=1",
    "test:quality": "node tools/checks/check-test-quality.mjs",
    "check:secrets": "node tools/security/check-secrets.mjs",
    "grace:lint": "bun ./node_modules/@osovv/grace-cli/src/grace.ts lint --path .",
    "grace:lint:init": "bun ./node_modules/@osovv/grace-cli/src/grace.ts lint --path . --allow-missing-docs",
    "grace:status": "bun ./node_modules/@osovv/grace-cli/src/grace.ts status --path . --with modules",
    "check": "bun run test:quality && bun run check:secrets && bun run format:check && turbo run lint typecheck test && bun run grace:lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@osovv/grace-cli": "^4.1.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "picomatch": "^4.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
